# SignalHub Environment Configuration Example

# Supabase Credentials (Client side accessible)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Credentials (Server side sensitive ONLY - DO NOT EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Multimodal AI Service (Server side sensitive ONLY)
AI_API_KEY=your-gemini-api-key

# Payment Gateway (Server side sensitive ONLY)
PAYMENT_PROVIDER_SECRET_KEY=your-stripe-or-razorpay-secret-key
PAYMENT_WEBHOOK_SECRET=your-payment-webhook-secret

# Security Secrets
CERTIFICATE_SIGNING_SECRET=your-unique-certificate-signing-secret
